# Backend Java REST API URL (Default proxy handles /api or specify direct endpoint)
VITE_API_BASE_URL=http://localhost:8080/api

# Google Maps JavaScript API Configuration (Part 3 & 15)
# Obtain from Google Cloud Console > APIs & Services > Credentials
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=

# Supabase Auth Configuration (Optional - for real client-side Supabase Auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
