# Supabase PostgreSQL Database Configuration
# Copy this file to .env and provide your actual credentials
# Do NOT commit your actual .env file with secrets to Git

SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
